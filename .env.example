# ==============================================================================
# Vazo E-Commerce Platform - Public Environment Variables (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# Any variable prefixed with `VITE_` is bundled into client-side JavaScript
# and is publicly visible in browser source inspection.
#
# NEVER store secrets, private keys, database passwords, or service-role keys
# in VITE_* variables or in this file.
#
# To use locally:
# 1. Copy this file to `.env.local`
# 2. Fill in your local development values
# ==============================================================================

# Application Metadata
VITE_APP_NAME="Vazo Studio"
VITE_APP_ENV="development"
VITE_APP_VERSION="0.1.0"

# Mock Mode Toggle
# Set to 'false' to connect to live Supabase backend
VITE_ENABLE_MOCK_DATA="true"

# Supabase (Public Browser Publishable / Anon Key ONLY)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_ANON_KEY="your-publishable-anon-key"

# Feature Flags
VITE_ENABLE_WHOLESALE_FLOW="true"
VITE_ENABLE_ADMIN_PANEL="true"
