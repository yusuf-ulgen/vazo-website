# ==============================================================================
# Vazo E-Commerce Platform - Public Environment Variables (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# Any variable prefixed with `VITE_` is bundled into client-side JavaScript
# and is publicly visible in browser source inspection.
#
# NEVER store secrets, private keys, database credentials, or admin passwords
# in VITE_* variables or in this file.
#
# To use locally:
# 1. Copy this file to `.env.local`
# 2. Fill in local development values
# ==============================================================================

# Application Metadata
VITE_APP_NAME="Vazo Studio"
VITE_APP_ENV="development"
VITE_APP_VERSION="0.1.0"

# Public API Endpoint Base (Mock or future proxy endpoint)
VITE_API_BASE_URL="http://localhost:5173/api"
VITE_ENABLE_MOCK_DATA="true"

# Feature Flags
VITE_ENABLE_WHOLESALE_FLOW="true"
VITE_ENABLE_ADMIN_PANEL="true"
